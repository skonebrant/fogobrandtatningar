---
import type { Faq } from '../data/services';
interface Props { items: Faq[]; heading?: string }
const { items, heading = 'Vanliga frågor' } = Astro.props;
---
<section class="band faq" aria-labelledby="faq-h">
  <div class="wrap">
    <div class="sec-head">
      <p class="kicker">FAQ</p>
      <h2 id="faq-h">{heading}</h2>
    </div>
    <div class="faq-list">
      {items.map((f) => (
        <details>
          <summary>{f.q}</summary>
          <div class="faq-a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list { border-top: 1px solid var(--line); max-width: 820px; }
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 1.15rem 2rem 1.15rem 0; position: relative;
    font-family: var(--display); font-weight: 700; font-size: 1.15rem; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: .2rem; top: 50%; transform: translateY(-50%);
    font-weight: 700; font-size: 1.4rem; color: var(--accent-deep); transition: transform .2s; }
  details[open] summary::after { content: '–'; }
  summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
  .faq-a { padding: 0 0 1.2rem; color: var(--muted); max-width: 64ch; }
</style>
