---
import { services } from '../data/services';
import { servicePath } from '../lib/seo';
interface Props {
  kicker?: string;
  heading?: string;
  intro?: string;
  /** slug to omit (e.g. on its own hub page) */
  exclude?: string;
}
const { kicker = 'Tjänster', heading = 'Vad vi gör', intro = 'Fogning och tätning för säkrare, tystare och torrare byggnader — från enstaka fog till komplett entreprenad.', exclude } = Astro.props;
const list = services.filter((s) => s.slug !== exclude);
---
<section class="band services" id="tjanster" aria-labelledby="tj-h">
  <div class="wrap">
    <div class="sec-head">
      <p class="kicker">{kicker}</p>
      <h2 id="tj-h">{heading}</h2>
      {intro && <p>{intro}</p>}
    </div>
    <div class="srv-grid">
      {list.map((s, i) => (
        <a class="srv" href={servicePath(s)}>
          <span class="no" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.name}</h3>
          <p>{s.short}</p>
          <span class="more">Läs mer <span aria-hidden="true">→</span></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  a.srv { text-decoration: none; color: inherit; }
  a.srv:hover h3 { color: var(--ink); }
</style>
